# Common
APP_ENV=development
LOG_LEVEL=debug

# JWT (shared for dev)
JWT_SECRET=very-secret-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Inter-service security
INTERNAL_TOKEN=dev-internal-token

# Ports (host-run)
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MATCHMAKING_SERVICE_PORT=8082
CHAT_SERVICE_PORT=8083
MODERATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# Databases (host-run services + docker-compose infra)
USER_DB_URL=postgres://user:pass@localhost:5432/users_db?sslmode=disable
CHAT_DB_URL=postgres://user:pass@localhost:5432/chat_db?sslmode=disable
MODERATION_DB_URL=postgres://user:pass@localhost:5432/moderation_db?sslmode=disable

# Redis (host-run services + docker-compose infra)
REDIS_URL=localhost:6379

# Inter-service URLs (host-run)
USER_SERVICE_URL=http://localhost:8081
MATCHMAKING_SERVICE_URL=http://localhost:8082
CHAT_SERVICE_URL=http://localhost:8083
MODERATION_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Run user-service (PowerShell example):
#   $env:PORT=$env:USER_SERVICE_PORT; $env:DB_URL=$env:USER_DB_URL; $env:REPO_DRIVER='postgres'; $env:INTERNAL_TOKEN=$env:INTERNAL_TOKEN; go run ./user-service/cmd

# Run chat-service (PowerShell example):
#   $env:PORT=$env:CHAT_SERVICE_PORT; $env:DB_URL=$env:CHAT_DB_URL; $env:REPO_DRIVER='postgres'; $env:INTERNAL_TOKEN=$env:INTERNAL_TOKEN; go run ./chat-service/cmd

# Run matchmaking-service (PowerShell example):
#   $env:PORT=$env:MATCHMAKING_SERVICE_PORT; $env:REDIS_URL=$env:REDIS_URL; $env:REPO_DRIVER='redis'; $env:INTERNAL_TOKEN=$env:INTERNAL_TOKEN; go run ./matchmaking-service/cmd

# Run moderation-service (PowerShell example):
#   $env:PORT=$env:MODERATION_SERVICE_PORT; $env:DB_URL=$env:MODERATION_DB_URL; $env:REPO_DRIVER='postgres'; $env:INTERNAL_TOKEN=$env:INTERNAL_TOKEN; $env:USER_SERVICE_URL=$env:USER_SERVICE_URL; $env:CHAT_SERVICE_URL=$env:CHAT_SERVICE_URL; $env:NOTIFICATION_SERVICE_URL=$env:NOTIFICATION_SERVICE_URL; go run ./moderation-service/cmd

# Run notification-service (PowerShell example):
#   $env:PORT=$env:NOTIFICATION_SERVICE_PORT; $env:INTERNAL_TOKEN=$env:INTERNAL_TOKEN; go run ./notification-service/cmd
