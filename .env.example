# --- GLOBAL CONFIGURATION ---
APP_ENV=production
LOG_LEVEL=info

# --- INFRASTRUCTURE (Ports & Bindings) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# --- SERVICE PORTS & BINDINGS ---
API_GATEWAY_BIND_ADDRESS=0.0.0.0
USER_SERVICE_PORT=8081
CHAT_SERVICE_PORT=8083
MATCHMAKING_SERVICE_PORT=8082
MODERATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# --- GRPC PORTS & URLS ---
USER_SERVICE_GRPC_PORT=50081
USER_SERVICE_GRPC_URL=user-service:50081
MATCHMAKING_SERVICE_GRPC_PORT=50082
CHAT_SERVICE_GRPC_PORT=50083
MODERATION_SERVICE_GRPC_PORT=50084
NOTIFICATION_SERVICE_GRPC_PORT=50085

# --- REPO DRIVERS ---
USER_REPO_DRIVER=postgres
MATCHMAKING_REPO_DRIVER=redis
CHAT_REPO_DRIVER=postgres
MODERATION_REPO_DRIVER=postgres

# --- SECURITY (Secrets from ansible/group_vars/secrets.yml) ---
JWT_SECRET=your-long-jwt-secret
INTERNAL_TOKEN=your-internal-token
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# --- DATABASE CONFIGURATION ---
POSTGRES_USER=mathalama
POSTGRES_PASSWORD=your-postgres-password
# URLs for services to connect within the Docker network
USER_DB_URL=postgres://mathalama:password@nektokz-postgres:5432/users_db?sslmode=disable
CHAT_DB_URL=postgres://mathalama:password@nektokz-postgres:5432/chat_db?sslmode=disable
MODERATION_DB_URL=postgres://mathalama:password@nektokz-postgres:5432/moderation_db?sslmode=disable

# --- REDIS CONFIGURATION ---
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@nektokz-redis:6379

# --- API GATEWAY ---
API_GATEWAY_PORT=8080
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DEV_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- COTURN (WebRTC) ---
TURN_USER=nektokz
TURN_PASSWORD=your-turn-password
TURN_EXTERNAL_IP=localhost
TURN_REALM=nektokz.kz
TURN_PORT=3478
TURN_TLS_PORT=5349

# --- MODERATION ---
TOXIC_WORDS=сука,блять,хуй,пизда,fuck,shit,bitch

# --- FRONTEND (Publicly accessible URLs) ---
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com/ws
